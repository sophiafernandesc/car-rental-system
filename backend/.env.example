# Copie este arquivo para .env e preencha com os dados do Supabase
# (Project Settings > Database > Connection string > Session pooler)

DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# Chave para assinar os tokens JWT (mínimo 32 caracteres)
# Gere com: openssl rand -base64 48
JWT_SECRET=
